            },
            "description": "SSL OFF en Postman.",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "pm.collectionVariables.set('web_token', j.accessToken);",
                  "console.log('web_token: ' + j.accessToken);"
